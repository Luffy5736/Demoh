body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  font-family: Arial, sans-serif;
  color: #262626;
}

.card {
  width: 350px;
  max-width: 92%;
  padding: 32px 28px;
  background: white;
  border: 1px solid #dbdbdb;
  text-align: center;
}

h1 {
  font-family: cursive;
  font-size: 38px;
  margin: 8px 0;
}

.notice {
  font-size: 12px;
  color: #666;
  margin: 12px 0 24px;
}

.preview {
  padding: 25px 12px;
  background: #f5f5f5;
  border-radius: 8px;
  margin-bottom: 18px;
}

.button {
  display: block;
  background: #0095f6;
  color: white;
  text-decoration: none;
  padding: 11px;
  border-radius: 7px;
  font-weight: bold;
}

footer {
  font-size: 12px;
  color: #888;
  margin-top: 22px;
}
```

