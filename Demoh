<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Instagram Login UI</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    width: 100%;
    min-height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Roboto, Helvetica, Arial, sans-serif;
}

body {
    background: #152126;
    color: #f5f5f5;
    min-height: 100vh;
    min-height: 100dvh;
}

.page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0 4.45%;
    display: flex;
    flex-direction: column;
}

.back {
    position: absolute;
    top: 27px;
    left: 38px;
    width: 25px;
    height: 25px;
    color: #f5f5f5;
}

.language {
    position: absolute;
    top: 12.4%;
    left: 0;
    width: 100%;
    text-align: center;
    color: #a8afb5;
    font-size: 17px;
    font-weight: 400;
}

.chevron {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-right: 2px solid #a8afb5;
    border-bottom: 2px solid #a8afb5;
    transform: rotate(45deg);
    margin-left: 7px;
    vertical-align: 4px;
}

.logo {
    position: absolute;
    top: 23.2%;
    left: 50%;
    width: 64px;
    height: 64px;
    transform: translateX(-50%);
}

.login-form {
    position: absolute;
    top: 41.7%;
    left: 4.45%;
    right: 4.45%;
}

.field {
    display: block;
    width: 100%;
    height: 67px;
    margin-bottom: 14px;
    padding: 0 18px;
    border: 1.5px solid #4b5054;
    border-radius: 22px;
    outline: none;
    background: transparent;
    color: #f5f5f5;
    font-size: 17px;
    font-family: inherit;
}

.field::placeholder {
    color: #a4a9af;
    opacity: 1;
}

.field:focus {
    border-color: #777f85;
}

.login-button {
    width: 100%;
    height: 61px;
    border: none;
    border-radius: 40px;
    background: #0866e9;
    color: white;
    font-size: 18px;
    font-weight: 600;
    margin-top: 0;
    cursor: pointer;
}

.forgot {
    display: block;
    width: 100%;
    margin-top: 25px;
    text-align: center;
    color: #f0f2f4;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
}

.demo-message {
    display: none;
    margin-top: 14px;
    text-align: center;
    color: #c6d8ff;
    font-size: 13px;
    line-height: 1.5;
}

.bottom {
    position: absolute;
    bottom: 2.6%;
    left: 4.45%;
    right: 4.45%;
    text-align: center;
}

.create {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 62px;
    border: 1.5px solid #529eff;
    border-radius: 40px;
    color: #529eff;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
}

.meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    margin-top: 20px;
    color: #e5e7eb;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.7px;
}

.meta svg {
    width: 29px;
    height: 21px;
}

@media (max-height: 650px) {
    .language { top: 10%; }
    .logo { top: 20%; }
    .login-form { top: 37%; }
    .bottom { bottom: 1.5%; }
    .field { height: 53px; margin-bottom: 9px; }
    .login-button { height: 50px; }
    .forgot { margin-top: 15px; }
    .create { height: 48px; }
    .meta { margin-top: 10px; }
}
</style>
</head>

<body>
<main class="page">

    <!-- Back arrow -->
    <svg class="back" viewBox="0 0 24 24"
         fill="none" stroke="currentColor"
         stroke-width="2.8" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5"></path>
        <path d="M12 19l-7-7 7-7"></path>
    </svg>

    <!-- Language -->
    <div class="language">
        English (US)<span class="chevron"></span>
    </div>

    <!-- Instagram-style gradient camera logo -->
    <svg class="logo" viewBox="0 0 64 64"
         fill="none" aria-label="Instagram-style logo">
        <defs>
            <linearGradient id="ig-gradient"
                x1="8" y1="58" x2="55" y2="3"
                gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#FFD600"/>
                <stop offset="0.28" stop-color="#FF7A00"/>
                <stop offset="0.52" stop-color="#FF0069"/>
                <stop offset="0.76" stop-color="#D300C5"/>
                <stop offset="1" stop-color="#7638FA"/>
            </linearGradient>
        </defs>
        <rect x="5" y="5" width="54" height="54" rx="15"
              stroke="url(#ig-gradient)" stroke-width="5.5"/>
        <circle cx="32" cy="32" r="13"
                stroke="url(#ig-gradient)" stroke-width="5.5"/>
        <circle cx="47.5" cy="16.5" r="3.5"
                fill="url(#ig-gradient)"/>
    </svg>

    <!-- Practice form: no credentials are transmitted -->
    <form class="login-form" id="demoForm">
        <input
            class="field"
            type="text"
            placeholder="Username, email or mobile number"
            autocomplete="off"
            aria-label="Demo username"
        >

        <input
            class="field"
            type="password"
            placeholder="Password"
            autocomplete="new-password"
            aria-label="Demo password"
        >

        <button class="login-button" type="submit">
            Log in
        </button>

        <a class="forgot" href="#" id="forgotLink">
            Forgot password?
        </a>

        <p class="demo-message" id="message" role="status">
            Practice interface only. No account is connected.
            Never enter real account passwords.
        </p>
    </form>

    <!-- Bottom buttons and branding -->
    <footer class="bottom">
        <a href="#" class="create" id="createLink">
            Create new account
        </a>

        <div class="meta">
            <svg viewBox="0 0 30 22" fill="none"
                 aria-hidden="true">
                <path d="M15 11C11 4 8 1 5 3C1 6 2 16 6 18
                         C10 20 13 12 15 11
                         C17 12 20 20 24 18
                         C28 16 29 6 25 3
                         C22 1 19 4 15 11Z"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
            </svg>
            <span>Meta</span>
        </div>
    </footer>

</main>

<script>
const message = document.getElementById("message");

document.getElementById("demoForm").addEventListener(
    "submit",
    function (event) {
        event.preventDefault();
        message.style.display = "block";
    }
);

document.getElementById("forgotLink").addEventListener(
    "click",
    function (event) {
        event.preventDefault();
        message.style.display = "block";
    }
);

document.getElementById("createLink").addEventListener(
    "click",
    function (event) {
        event.preventDefault();
        message.style.display = "block";
    }
);
</script>

</body>
</html>
